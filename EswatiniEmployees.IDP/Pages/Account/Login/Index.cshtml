@page
@model EswatiniEmployees.IDP.Pages.Login.Index

<div class="auth-shell login-page">
    <div class="auth-card">
        <div class="auth-heading">
            <span class="eyebrow">Eswatini Employees</span>
            <h1>Welcome back</h1>
            <p>Sign in to continue to your secure employee workspace.</p>
        </div>

        <partial name="_ValidationSummary" />

        @if (Model.View.EnableLocalLogin)
        {
            <div class="local-login-section">
                <form asp-page="/Account/Login/Index">
                    <input type="hidden" asp-for="Input.ReturnUrl" />

                    <div class="form-field">
                        <label asp-for="Input.Username"></label>
                        <input class="form-control" placeholder="Username or email" asp-for="Input.Username" autofocus>
                    </div>
                    <div class="form-field">
                        <label asp-for="Input.Password"></label>
                        <input type="password" class="form-control" placeholder="Password" asp-for="Input.Password" autocomplete="off">
                    </div>

                    @if (Model.View.AllowRememberLogin)
                    {
                        <div class="remember-row">
                            <input class="form-check-input" asp-for="Input.RememberLogin">
                            <label class="form-check-label" asp-for="Input.RememberLogin">Remember me</label>
                        </div>
                    }

                    <div class="login-links">
                        <a asp-page="/Account/ForgotPassword/ForgotPassword" asp-route-returnUrl="@Model.Input.ReturnUrl">Forgot password?</a>
                    </div>
                    <button class="btn btn-primary btn-block auth-submit" name="Input.Button" value="login">Sign in</button>
                    <button class="btn btn-secondary btn-block auth-cancel" name="Input.Button" value="cancel">Cancel</button>
                </form>
            </div>
        }

        @if (Model.View.VisibleExternalProviders.Any())
        {
            <div class="external-login-section">
                <div class="divider"><span>Sign in with</span></div>
                <div class="external-buttons">
                    @foreach (var provider in Model.View.VisibleExternalProviders)
                    {
                        <a class="btn btn-external" asp-page="/ExternalLogin/Challenge" asp-route-scheme="@provider.AuthenticationScheme" asp-route-returnUrl="@Model.Input.ReturnUrl">
                            <span class="provider-icon">G</span>
                            @provider.DisplayName
                        </a>
                    }
                </div>
            </div>
        }

        @if (!Model.View.EnableLocalLogin && !Model.View.VisibleExternalProviders.Any())
        {
            <div class="alert alert-warning">
                <strong>Invalid login request</strong>
                There are no login schemes configured for this request.
            </div>
        }
    </div>
</div>